PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
# Plain password used only when ADMIN_PASSWORD_HASH is empty (dev default).
ADMIN_PASSWORD=northgo-admin-change-me
# Prefer a scrypt hash from: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
